# hub.1880.io on Hostinger: environment variables for the client portal app.
# The 1880.io app has its own file: deploy/hostinger/public.env.example (your filled copy: .env.hostinger.local). Keep DATABASE_URL,
# SITE_URL, RESEND_API_KEY and MAIL_FROM the same in both.
# Template in the repo (no secrets). Your filled copy stays on your computer and in your
# password manager; .gitignore skips *.local so it is never committed.
# Hostinger replaces the whole list on every save, so always import or paste ALL of it.
# After any change, redeploy so the site rebuilds with the new values.

# --- Required ---------------------------------------------------------------

# The MySQL database from hPanel. Replace PASSWORD with the real one (never commit it).
# HOST is often "localhost" when the app and database are on the same plan.
# If the password has symbols like @ / : # ?, URL-encode them (or use letters and numbers only).
DATABASE_URL=mysql://u949197327_1880io:PASSWORD@localhost:3306/u949197327_1880io

# The main site's address (the portal's own address, https://hub.1880.io, is worked out from it).
SITE_URL=https://1880.io

# This app serves only the client portal.
SITE_ROLE=portal

# The 1880.io app updates the shared database; this one leaves it alone.
SKIP_MIGRATIONS=1

# The client portal lives at hub.1880.io.
PORTAL_SUBDOMAIN=hub


# --- Add later ----------------------------------------------------------------

# Email (sign-in links, invites, contact-form alerts). Add once Resend is set up
# (docs/LAUNCH.md step 6). Without it, the site still works; it just can't send email.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# The sender. Already the default, so only set it to change it.
# MAIL_FROM=1880 Consulting <notifications@1880consulting.com>

# No analytics in the private portal.

# Adobe Fonts kit for Neue Haas Grotesk (body copy). The id from the kit's address,
# https://use.typekit.net/<id>.css. Add 1880.io and hub.1880.io to the kit's web project first.
ADOBE_FONTS_KIT=eeh2ful
