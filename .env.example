# Which surfaces this deployment serves: public | portal | all (default: all)
SITE_ROLE=all

# Subdomain of 1880.io for the client portal: hub.1880.io (PLAN D44).
PORTAL_SUBDOMAIN=hub

# Database. Leave unset locally to use the Docker MySQL (npm run db:up).
# A production build (npm run build) needs it, because published pages are built from the database.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/studio

# Email alerts for new inquiries, sent through Resend. Without a key, inquiries
# are still saved; their alert shows "Not emailed".
# RESEND_API_KEY=re_...
# MAIL_FROM=1880 Consulting <notifications@1880consulting.com>

# Where replies to site emails go (the sending address has no mailbox).
MAIL_REPLY_TO=inquiries@1880consulting.com

# The site's address: links in emails, and the canonical, share and sitemap URLs.
# Set it before `npm run build` in production (those URLs are built into pages).
# SITE_URL=https://1880.io

# Google Analytics 4 for the public site (never Studio or the portal). Off unless set.
# GA_MEASUREMENT_ID=G-FNXWW6CRNM

# A second app sharing this database (the hub.1880.io app) sets this, so only
# one app applies database migrations during its build.
# SKIP_MIGRATIONS=1

# The portal's address, for emailed sign-in links. Defaults to SITE_URL with
# PORTAL_SUBDOMAIN in front (https://1880.io → https://hub.1880.io).
# PORTAL_URL=https://hub.1880.io

# A staging copy for review: keep every page out of search engines.
# SITE_INDEXING=off

# Which network interface the production server listens on (default 0.0.0.0).
# BIND_HOST=0.0.0.0

# One-time code for creating the first Studio owner at /admin/setup (24+ characters).
# Remove it once an owner exists; the page closes by itself anyway.
# STUDIO_SETUP_TOKEN=

# Adobe Fonts kit for Neue Haas Grotesk (body copy). The id from the kit's address,
# https://use.typekit.net/<id>.css. Add 1880.io and hub.1880.io to the kit's web project first.
# ADOBE_FONTS_KIT=
